# ===================================================
# .gitignore - Sistema Contable ERP (Producción + QA)
# Incluye pruebas de Playwright, excluye carpetas legacy & dumps SQL
# ===================================================

# 1. Carpetas Antiguas y Legacy OSMC
/carpetas_de_osmc/

# 2. Scripts de Prueba Temporales, Seeders y Dumps SQL
*.sql
/sql/
/scratch/
/limpiar_requisiciones.php
/scratch_check_cuentas.php
/scratch_check_cuentas_and_stats.php
/v.php
scratch_*.php

# 3. Artefactos Temporales de Ejecución de Playwright (Los specs y configs SÍ SE INCLUYEN)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# 4. Dependencias de Paquetes y Compilados
/vendor/
/node_modules/
/frontend/node_modules/
/frontend/dist/
/frontend/dist-ssr/

# 5. Logs y Rastreo de Ejecución
/logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# 6. Archivos de Entorno y Variables Sensibles
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 7. Archivos del Sistema Operativo y Editores (IDE)
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 8. Archivos de Subida Temporales
/uploads/*
!/uploads/.gitkeep
